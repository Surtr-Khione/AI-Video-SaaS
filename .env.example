# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_video_saas"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (for sending invitations)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Video SaaS"

# Viral Marketing Config
REFERRAL_REWARD_CREDITS=100
REFEREE_REWARD_CREDITS=50
VIRAL_UNLOCK_THRESHOLD=3
