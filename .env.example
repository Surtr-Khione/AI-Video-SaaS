# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_video_saas"
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this

# Social Media API Keys
# Facebook/Instagram
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Instagram (uses Facebook Graph API)
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# X (Twitter)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret
X_BEARER_TOKEN=your_x_bearer_token

# Storage
VIDEO_STORAGE_PATH=/var/videos
MAX_VIDEO_SIZE_MB=500

# Analytics
VIRALITY_THRESHOLD_MULTIPLIER=3.0
HIGH_ENGAGEMENT_PERCENTILE=80
ANALYTICS_SYNC_INTERVAL_HOURS=1

# AI Training
MIN_VIDEOS_FOR_TRAINING=100
TRAINING_DATA_EXPORT_PATH=/var/training-data
