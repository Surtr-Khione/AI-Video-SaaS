generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  X_TWITTER
  HOSTED
}

enum VideoStatus {
  PROCESSING
  ACTIVE
  ARCHIVED
  FAILED
}

enum ViralityLevel {
  LOW
  MEDIUM
  HIGH
  VIRAL
  SUPER_VIRAL
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  name                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  videos                Video[]
  socialMediaAccounts   SocialMediaAccount[]
  apiKeys               ApiKey[]
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String
  key         String   @unique
  name        String
  lastUsed    DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Video {
  id                    String                 @id @default(uuid())
  userId                String
  title                 String
  description           String?
  filePath              String
  thumbnailPath         String?
  duration              Int
  fileSize              BigInt
  mimeType              String
  status                VideoStatus            @default(PROCESSING)
  aiGeneratedMetadata   Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  views                 VideoView[]
  socialMediaPosts      SocialMediaPost[]
  engagementMetrics     EngagementMetrics[]
  viralityScore         ViralityScore?
  trainingDataPoints    TrainingDataPoint[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model VideoView {
  id              String   @id @default(uuid())
  videoId         String
  ipAddress       String?
  userAgent       String?
  country         String?
  city            String?
  referrer        String?
  watchDuration   Int?
  completionRate  Float?
  viewedAt        DateTime @default(now())
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([viewedAt])
}

model SocialMediaAccount {
  id              String            @id @default(uuid())
  userId          String
  platform        Platform
  accountId       String
  accountName     String
  accessToken     String
  refreshToken    String?
  tokenExpiry     DateTime?
  isActive        Boolean           @default(true)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           SocialMediaPost[]

  @@unique([userId, platform, accountId])
  @@index([userId])
  @@index([platform])
}

model SocialMediaPost {
  id                    String                 @id @default(uuid())
  videoId               String
  socialMediaAccountId  String
  platform              Platform
  platformPostId        String
  postUrl               String?
  publishedAt           DateTime
  lastSyncedAt          DateTime               @default(now())
  createdAt             DateTime               @default(now())
  video                 Video                  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  socialMediaAccount    SocialMediaAccount     @relation(fields: [socialMediaAccountId], references: [id], onDelete: Cascade)
  analytics             SocialMediaAnalytics[]

  @@unique([platform, platformPostId])
  @@index([videoId])
  @@index([socialMediaAccountId])
  @@index([platform])
}

model SocialMediaAnalytics {
  id                    String           @id @default(uuid())
  socialMediaPostId     String
  platform              Platform
  views                 BigInt           @default(0)
  likes                 Int              @default(0)
  comments              Int              @default(0)
  shares                Int              @default(0)
  saves                 Int              @default(0)
  clickThroughRate      Float?
  averageWatchTime      Int?
  audienceRetention     Float?
  impressions           BigInt?
  reach                 BigInt?
  engagementRate        Float?
  demographicData       Json?
  topLocations          Json?
  trafficSources        Json?
  snapshotAt            DateTime         @default(now())
  socialMediaPost       SocialMediaPost  @relation(fields: [socialMediaPostId], references: [id], onDelete: Cascade)

  @@index([socialMediaPostId])
  @@index([platform])
  @@index([snapshotAt])
}

model EngagementMetrics {
  id                    String         @id @default(uuid())
  videoId               String
  platform              Platform
  totalViews            BigInt         @default(0)
  totalLikes            Int            @default(0)
  totalComments         Int            @default(0)
  totalShares           Int            @default(0)
  totalSaves            Int            @default(0)
  engagementScore       Float          @default(0)
  engagementPercentile  Int?
  averageWatchTime      Int?
  completionRate        Float?
  clickThroughRate      Float?
  conversionRate        Float?
  sentimentScore        Float?
  calculatedAt          DateTime       @default(now())
  video                 Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, platform])
  @@index([videoId])
  @@index([platform])
  @@index([engagementScore])
  @@index([calculatedAt])
}

model ViralityScore {
  id                    String         @id @default(uuid())
  videoId               String         @unique
  viralityLevel         ViralityLevel  @default(LOW)
  viralityScore         Float          @default(0)
  velocityScore         Float          @default(0)
  peakViews24h          BigInt         @default(0)
  peakViews7d           BigInt         @default(0)
  shareVelocity         Float          @default(0)
  commentVelocity       Float          @default(0)
  growthRate            Float          @default(0)
  isViral               Boolean        @default(false)
  viralStartDate        DateTime?
  predictedReach        BigInt?
  factors               Json?
  calculatedAt          DateTime       @default(now())
  video                 Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([viralityLevel])
  @@index([viralityScore])
  @@index([isViral])
}

model TrainingDataPoint {
  id                    String   @id @default(uuid())
  videoId               String
  features              Json
  metrics               Json
  viralityOutcome       Boolean
  engagementOutcome     Float
  platformPerformance   Json
  contentFeatures       Json?
  audienceFeatures      Json?
  timingFeatures        Json?
  createdAt             DateTime @default(now())
  video                 Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([viralityOutcome])
  @@index([createdAt])
}

model AnalyticsJob {
  id              String   @id @default(uuid())
  jobType         String
  status          String
  targetId        String?
  platform        Platform?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  errorMessage    String?
  metadata        Json?

  @@index([jobType])
  @@index([status])
  @@index([platform])
}

model SystemMetrics {
  id                    String   @id @default(uuid())
  totalVideos           Int      @default(0)
  totalViews            BigInt   @default(0)
  totalEngagements      BigInt   @default(0)
  viralVideosCount      Int      @default(0)
  avgEngagementRate     Float    @default(0)
  platformBreakdown     Json
  topPerformingVideos   Json
  recordedAt            DateTime @default(now())

  @@index([recordedAt])
}
